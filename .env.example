# Config do Hub — copie para `.env` (o .env real fica FORA do git, só na VM).
#   cp .env.example .env   &&   edite os valores
# O docker-compose lê este .env automaticamente.

# Porta publicada na VM (default 8000). No ambiente atual a 80 está ocupada pelo
# Conciliador, então o Hub sobe na 8001.
HOST_PORT=8001

# Segredo do JWT. Em prod é OBRIGATÓRIO trocar (o startup falha com o default
# quando SUPERFRIO_ENV=prod). Gere um forte:  openssl rand -hex 32
SUPERFRIO_JWT_SECRET=troque-por-uma-string-aleatoria-forte
SUPERFRIO_ENV=prod

# --- Postgres (Lote 2) ---
# Credenciais do container `db`. Em prod, defina uma senha forte aqui.
POSTGRES_USER=hub
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=hub

# Connection string que o Hub usa. Aponta pro service `db` do compose.
# A senha aqui tem que bater com POSTGRES_PASSWORD acima.
# Para ROLLBACK pro SQLite: comente esta linha (cai no volume ./data).
DATABASE_URL=postgresql+psycopg://hub:troque-por-uma-senha-forte@db:5432/hub

# --- Login com Microsoft Entra ID / SSO (ATIVO em prod desde 21/08/2026) ---
# Deixe as 4 em branco para manter o SSO DESLIGADO (só login local) — é o
# default seguro e também o rollback: esvaziar estas 4 faz o botão "Entrar com
# Microsoft" desaparecer sem tocar em nada mais.
# Os valores vêm do App Registration no Azure/Entra:
#   TENANT_ID     = Overview > "Directory (tenant) ID"
#   CLIENT_ID     = Overview > "Application (client) ID"
#   CLIENT_SECRET = Certificates & secrets > Client secrets > coluna VALUE
#                   (não é o "Secret ID"; o Value só aparece na criação, e ELE
#                    EXPIRA — anote a data de validade em algum lugar visível)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Tem que ser IDÊNTICO ao Redirect URI registrado no Entra, sem barra no final.
# Produção: https://hub.superfrio.com.br/api/auth/callback
# Dev:      http://localhost:8000/api/auth/callback
ENTRA_REDIRECT_URI=

# Opcional: id de um grupo de segurança do Entra. Vazio = qualquer conta do
# tenant pode se autenticar (o registro do app já restringe a "somente locatário
# único"). Exigir grupo depende do claim opcional `groups` no ID token — sem ele
# configurado no App Registration, NINGUÉM entra.
ENTRA_ALLOWED_GROUP_ID=

# Criação automática de cadastro no primeiro login (JIT). Vazio/0 = DESLIGADA:
# quem não tem cadastro no Hub recebe "peça acesso ao administrador" e nada é
# gravado. Foi a decisão de 21/08/2026, depois do primeiro teste com gente real
# (cadastro nascia sozinho a cada pessoa curiosa que clicava no botão).
# ENTRA_AUTO_PROVISION=1 volta ao comportamento anterior: qualquer conta do
# tenant entra sozinha, sem nenhuma role, e o admin concede acesso depois.
ENTRA_AUTO_PROVISION=

# --- FTP de Processos Abertos (job diário 08:05, retentativa 08:30) ---
# Servidor FTPS onde o Pentaho deposita os relatórios do SLIN e do BY/JDA
# (job `export_processos_abertos_v01_main`, roda às 8h). Usuário master do
# FTP — NUNCA commitar o valor real, só existe no .env da VM e no seu local.
FTP_HOST=ftp-sf.superfrio.com.br
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=

# --- Volumetria ---
# Fuso em que data/hora aparecem na tela (o servidor roda em UTC). Vale para as
# três volumetrias.
VOLUMETRIA_FUSO_EXIBICAO=America/Sao_Paulo
# Primeiro dia com que a tela do CATERING abre: `ano-corrente` (1º de janeiro do
# ano de hoje) ou uma data AAAA-MM-DD para pinar. Transporte e estoque têm a
# abertura própria (VOLUMETRIA_TRN_ABERTURA_DE / VOLUMETRIA_EST_ABERTURA_DE).
VOLUMETRIA_ABERTURA_DE=ano-corrente

# --- DW Oracle (fonte direta das três volumetrias) ---
# As três leem o DW Oracle direto, sem banco intermediário
# (docs/PLANO_VOLUMETRIA_DW_DIRETO.md e docs/PLANO_VOLUMETRIA_TRANSPORTE_ESTOQUE.md).
#
# USUÁRIO E SENHA SÃO DE SOMENTE LEITURA e existem só no .env da VM: a Maria os
# digita à mão, sem passar por chat, PR ou script de deploy. Vazio = os cards
# de diagnóstico respondem 503 nomeando a variável, e o resto do Hub não sente.
#
# ⚠️ Os nomes são DIFERENTES dos da nuvem-ia (`DW_USER`/`DW_SENHA`) de propósito:
# aquela é a credencial da CARGA, que tem escrita no Postgres dela. Copiar a
# linha de lá para cá não conecta nada — e é isso que se quer.
DW_LEITURA_USUARIO=
DW_LEITURA_SENHA=
# Não são segredo: têm padrão no código e só precisam de valor aqui se mudarem.
# (o `DW_SERVICO` é o que a nuvem-ia chama de `DW_BANCO` — é o service name)
#   DW_HOST=oracleprd-aws.superfrio.com.br
#   DW_PORTA=1521
#   DW_SERVICO=pdwgener

# --- Volumetria de Catering no DW (backend/volumetria_catering/) ---
# Mesma credencial de leitura acima. Nome dos objetos, caso o DW publique outra
# versão das tabelas (hoje `_V01`):
#   DW_TABELA_REC=DM_VOLUMETRIA.FATO_VOL_REC_CAT_V01
#   DW_TABELA_EXP=DM_VOLUMETRIA.FATO_VOL_EXP_CAT_V01

# --- Volumetria de Transporte (backend/volumetria_transporte/) ---
# Mesma credencial de leitura acima — sem GRANT novo: confirmado pela Maria
# em 03/set que o usuário já lê as duas tabelas novas
# (docs/PLANO_VOLUMETRIA_TRANSPORTE_ESTOQUE.md, T0).
#   DW_TABELA_TRN=DM_VOLUMETRIA.FATO_VOL_TRN_CAT_V01

# --- Volumetria de Estoque (backend/volumetria_estoque/) ---
# Mesma credencial de leitura acima.
#   DW_TABELA_EST=DM_VOLUMETRIA.FATO_VOL_EST_CAT_V01

# --- SuperfrioIA (backend/ia/) --- provedor de teste (falso) ou Claude (anthropic) ---
# Chave mestra. DESLIGADA por padrao: o deploy do codigo nao expoe nada. Desligada, as
# rotas /api/ia/* respondem 404 e o card some mesmo que ja exista no banco. Ligar exige
# reiniciar (o seed do card roda no boot). O codigo le a chave a cada requisicao, mas EM DOCKER
# o container so ve o .env quando e recriado: tanto para ligar quanto para DESLIGAR e preciso
# `docker compose up -d` (restart nao rele o .env). Fora do Docker, desligar vale na proxima requisicao.
IA_HABILITADO=false
# Provedor do modelo: `falso` (sem rede, sem chave) ou `anthropic` (Claude; exige a chave
# abaixo e saida HTTPS para api.anthropic.com:443). Nome desconhecido falha alto.
IA_PROVEDOR=falso
# O docker-compose.yml repassa estas variaveis ao container (padroes seguros: desligado, provedor
# `falso`, autoaprovacao DESLIGADA, chave vazia). O container so le o .env quando e recriado:
# `docker compose up -d` (restart nao rele). Runbook: docs/RUNBOOK_SUPERFRIOIA.md.
# Chave da API da Anthropic. NUNCA preencher este arquivo (ele vai para o Git): na maquina
# de desenvolvimento vai no `.env.local` (ignorado pelo Git; conferir com
# `git check-ignore -v .env.local`) e na VM no `.env` digitado a mao. Vazia = a pergunta
# responde a mensagem neutra e a trilha registra `provedor_sem_chave`.
ANTHROPIC_API_KEY=
# Modelo (D-2: Sonnet 5.5). Configuravel; o padrao esta em backend/ia/config.py.
#   IA_MODELO=claude-sonnet-5-5
# Tempos e tentativas do provedor (todos opcionais).
#   IA_TIMEOUT_S=30                 # UMA tentativa HTTP ao modelo (o SDK refaz ate IA_TENTATIVAS vezes)
#   IA_PRAZO_PERGUNTA_S=55          # prazo conferido ANTES de cada rodada (nao e limite duro); abaixo do ALB (60 s)
#   IA_TENTATIVAS=2                 # novas tentativas do SDK em 429/5xx/conexao (0 desliga)
#   IA_MAX_TOKENS_SAIDA=1024
#   IA_REPAROS=1                    # reescritas pedidas ao modelo quando o verificador reprova
# So enviados ao provedor se preenchidos (valor e disponibilidade dependem do contrato):
#   IA_ESFORCO=medium               # low | medium | high | xhigh | max
#   IA_INFERENCE_GEO=               # regiao de processamento (D-1)
# Estimativa de custo por pergunta: SEM padrao de proposito (valor inventado viraria
# "custo medido"). Preencher com a tabela de precos da conta; sem isso, so tokens.
#   IA_PRECO_ENTRADA_USD_MTOK=
#   IA_PRECO_SAIDA_USD_MTOK=
#   IA_PRECO_CACHE_LEITURA_USD_MTOK=   # opcional: sem isso, 0,1x da entrada
#   IA_PRECO_CACHE_ESCRITA_USD_MTOK=   # opcional: sem isso, 1,25x da entrada
#   IA_CAMBIO_USD_BRL=
# Limites (todos opcionais; valor invalido cai no padrao). Decisoes DD-16, DD-24, DD-25.
#   IA_COTA_DIA=30                  # perguntas por usuario por dia
#   IA_TAM_PERGUNTA=1000            # caracteres por pergunta
#   IA_MAX_CONSULTAS=3              # chamadas LOGICAS ao indicador por pergunta
#   IA_MAX_OPERACOES_DW=12          # trabalho INTERNO por pergunta (conexoes ao DW)
#   IA_MAX_PAGINAS=5                # paginas de unidades lidas por um ranking
#   IA_MAX_PASSOS=8                 # execucoes de ferramenta por pergunta
#   IA_MAX_SIMULTANEAS=2            # perguntas em andamento por usuario (por processo/worker)
#   IA_TAM_RESULTADO=20000          # caracteres do resultado de UMA ferramenta enviado ao modelo
#   IA_RETENCAO_MENSAGENS_DIAS=90
#   IA_RETENCAO_CONSULTAS_DIAS=180
#   IA_VALIDADE_CONCESSAO_DIAS=180
# Autoaprovacao de concessao: permitida na PoC (marcada no evento). Antes do piloto: false.
#   IA_AUTOAPROVACAO=true
